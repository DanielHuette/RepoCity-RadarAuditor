# Supabase project URL (Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase service role key (Settings -> API), used by the worker and the CLI
SUPABASE_SERVICE_KEY=
# Google Cloud API key with PageSpeed Insights API and Places API (New) enabled
GOOGLE_API_KEY=
# Local folder for job hand-off between the worker and Claude Code
RADAR_WORK_DIR=./work
# File the worker touches after each stored heartbeat, read by the container health check; empty means worker-alive in RADAR_WORK_DIR
WORKER_ALIVE_FILE=
# Persistent browser profile of the server browser (logins for Google, ChatGPT, Gemini)
BROWSER_PROFILE_DIR=./browser-profile
# Forecast curves (click rates, enquiry rates), relative to the working directory
FORECAST_PATH=config/prognose.yaml
# Report and document templates, relative to the working directory
TEMPLATES_DIR=templates
# Check catalogue with checks, weights and thresholds
CATALOGUE_PATH=config/pruefkatalog.yaml
# Question templates for the AI assistants; empty means fragen.yaml next to the catalogue
QUESTIONS_PATH=
# Service packages for quotes, service descriptions and contracts; empty means pakete.yaml next to the catalogue
PACKAGES_PATH=
# Industry groups with labels and older stored values; empty means branchen.yaml next to the catalogue
INDUSTRIES_PATH=
# Signals, thresholds and contact ways of the customer search; empty means kundensuche.yaml next to the catalogue
PROSPECT_CRITERIA_PATH=
# Webhook address of the customer-management system that receives events; empty disables delivery
EVENT_ENDPOINT=
# DataForSEO account login; DataForSEO is switched on and capped in the app settings (source dataforseo)
DATAFORSEO_LOGIN=
# DataForSEO account password
DATAFORSEO_PASSWORD=
# Euros per US dollar for the DataForSEO cost against the monthly cost cap; 1 errs on the safe side
DATAFORSEO_EUR_PER_USD=1
# Euros per US dollar for the Google Places price list (audits and customer search) against the monthly cost caps
GOOGLE_EUR_PER_USD=1
# ChatGPT, Gemini and Perplexity are asked on their websites in the server browser first. The keys
# below are the paid fallback when a website blocks the browser, asks for a login or times out;
# empty means no fallback for that assistant.
# OpenAI key, fallback for ChatGPT
OPENAI_API_KEY=
# Gemini API key, fallback for Gemini
GEMINI_API_KEY=
# Perplexity API key, fallback for Perplexity
PERPLEXITY_API_KEY=
# OpenAI model of the ChatGPT fallback
OPENAI_MODEL=gpt-4o-mini
# Gemini model of the Gemini fallback
GEMINI_MODEL=gemini-3.8-flash
# Preset of the Perplexity fallback: fast, low or high
PERPLEXITY_MODEL=fast
# Model Claude Code answers the assistant questions with (Claude is always asked through Claude Code, ANALYSIS_CLAUDE_COMMAND)
CLAUDE_MODEL=claude-haiku-4-5
# Seconds one assistant answer may take on a website or in Claude Code before it counts as failed
ASSISTANT_TIMEOUT_SECONDS=120
# Google OAuth desktop client id; needed only for audits with customer access (radarauditor google auth)
GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth desktop client secret belonging to the client id above
GOOGLE_OAUTH_CLIENT_SECRET=
# Analysis step: the worker runs Claude Code headless (`claude -p`); without an answer the job is re-queued
# Claude Code executable, a name on PATH or a full path
ANALYSIS_CLAUDE_COMMAND=claude
# Seconds one headless analysis may take before it is stopped and the job is re-queued
ANALYSIS_TIMEOUT_SECONDS=900
# Project directory Claude Code runs in; must hold .claude/commands/auswerten.md and skills/radar-auswerter
ANALYSIS_PROJECT_DIR=.
# Claude Code permission mode; dontAsk denies everything except reading and writing findings.json and texte.json
ANALYSIS_PERMISSION_MODE=dontAsk
# Claude Code model for the analysis; empty uses the default model of the Claude Code login
ANALYSIS_MODEL=
# Mail reading: the worker takes mails the CRM queued in crm.mail_triage and asks Claude Code about one per idle poll
# (subscription login, no tools, no settings, plugins, hooks or MCP servers of the host) whether an unknown sender is a
# possible customer or a customer accepts or declines a quote
# Mails taken from the CRM at once, 0 to 50; 0 switches mail reading off
MAIL_TRIAGE_BATCH=5
# Seconds one answer about a mail may take; MAIL_TRIAGE_BATCH times this may not exceed 3600
MAIL_TRIAGE_TIMEOUT_SECONDS=120
# Seconds the taken mails stay reserved for this worker, 30 to 3600; at least MAIL_TRIAGE_BATCH times MAIL_TRIAGE_TIMEOUT_SECONDS
MAIL_TRIAGE_CLAIM_SECONDS=900
# Claude Code model that reads the mails
MAIL_TRIAGE_MODEL=sonnet
# Cockpit assistant: the worker takes the requests Daniel typed or spoke in the Cockpit (crm.assistant_requests), turns a
# recording into text with the speech service of the phone assistant, lets Claude Code read the request as one of four tasks
# (subscription login, no tools) and hands that to the CRM, which carries it out and reports in the Cockpit
# Address of the speech service of the phone assistant (POST /transcribe); on the shared server http://host.docker.internal:8090,
# empty means spoken requests are answered with "Die Spracherkennung ist auf dem Server nicht eingerichtet."
SPEECH_URL=
# Seconds one transcription may take; it is tried up to 3 times, and 3 times this plus COCKPIT_ASSISTANT_TIMEOUT_SECONDS must stay below 600
SPEECH_TIMEOUT_SECONDS=60
# Seconds between looks for a new request while none waits, 0 to 3600; 0 switches the Cockpit assistant off
COCKPIT_ASSISTANT_POLL_SECONDS=10
# Seconds Claude Code may take to read one request
COCKPIT_ASSISTANT_TIMEOUT_SECONDS=120
# Claude Code model that reads the requests
COCKPIT_ASSISTANT_MODEL=sonnet
